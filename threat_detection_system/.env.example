# Copy this file to .env and fill in real values. .env is gitignored -- never commit real secrets.

# --- Database (see db_scripts/) ---------------------------------------------
DATABASE_URL=postgresql://threat_detection_user:CHANGE_ME@localhost:5432/threat_detection

# --- LLM (OpenAI is the default provider for local dev/testing) -------------
OPENAI_API_KEY=sk-...
LLM_MODEL=openai:gpt-4o-mini
LLM_SUMMARY_MODEL=gpt-4o-mini

# --- Speech-to-Text (faster-whisper, runs locally -- no key needed) ---------
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# --- Speaker Diarization (pyannote.audio; gated model, requires a token) ----
# Accept the model license at https://huggingface.co/pyannote/speaker-diarization-3.1
# then create a token at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=hf_...
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# --- Emotion Recognition (SpeechBrain, downloads weights on first use) ------
EMOTION_MODEL=speechbrain/emotion-recognition-wav2vec2-IEMOCAP
