# Copy this file to .env and fill in real values. .env is gitignored -- never commit real secrets.

# --- LLM (OpenAI is the default provider for local dev/testing) -------------
OPENAI_API_KEY=sk-...
LLM_MODEL=openai:gpt-4o-mini
LLM_TEXT_MODEL=gpt-4o-mini

# --- TTS (Piper, runs locally -- no key needed) ------------------------------
PIPER_VOICES_DIR=configs/voices
DEFAULT_PIPER_VOICE=en_US-amy-medium

# --- Output -------------------------------------------------------------------
DATASET_OUTPUT_DIR=datasets

# --- Reproducibility ------------------------------------------------------------
DEFAULT_SEED=42
